VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tiny ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( -10000 -5000 ) ( 90000 85000 ) ;
ROW r0 CORE_SITE 0 0 N DO 80 BY 1 STEP 1000 0 ;
TRACKS X 0 DO 225 STEP 400 LAYER M2 ;
TRACKS Y 0 DO 212 STEP 400 LAYER M1 ;
# 两条 X pattern 合并后构成非均匀网格，最后补 DIEAREA 的边界。
GCELLGRID X -10000 DO 9 STEP 10000 ;
GCELLGRID X 70000 DO 3 STEP 7000 ;
GCELLGRID Y -5000 DO 10 STEP 10000 ;
COMPONENTS 8 ;
 - u_N TEST + PLACED ( 0 0 ) N ;
 - u_S TEST + PLACED ( 20000 0 ) S ;
 - u_E TEST + PLACED ( 40000 0 ) E ;
 - u_W TEST + PLACED ( 60000 0 ) W ;
 - u_FN TEST + PLACED ( 0 20000 ) FN ;
 - u_FS TEST + PLACED ( 20000 20000 ) FS ;
 - u_FE TEST + PLACED ( 40000 20000 ) FE ;
 - u_FW TEST + PLACED ( 60000 20000 ) FW ;
END COMPONENTS
PINS 2 ;
 - top_in + NET cross + DIRECTION INPUT + USE SIGNAL
   + PORT + LAYER M1 ( -100 -200 ) ( 300 400 )
   + FIXED ( 80000 50000 ) N ;
 - top_out + NET cross + DIRECTION OUTPUT + USE SIGNAL
   + PORT + LAYER M2 ( 100 200 ) ( 300 400 )
   + FIXED ( 81000 65000 ) E ;
END PINS
SPECIALNETS 1 ;
 - VDD ( * VDD ) + USE POWER ;
END SPECIALNETS
NETS 3 ;
 - tree ( u_N B ) ( u_S A ) ( u_E A ) ( u_W A )
   + USE SIGNAL + WEIGHT 3
   + ROUTED M1 ( 1000 1000 ) ( 2000 1000 )
     NEW M2 ( 2000 1000 ) ( 2000 2000 ) ;
 - cross ( PIN top_in ) ( u_FN B ) ( u_FS A ) ( PIN top_out )
   + USE SIGNAL ;
 - mirror ( u_FE B ) ( u_FW A ) + USE SIGNAL ;
END NETS
END DESIGN
